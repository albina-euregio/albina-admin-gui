{
  "image": "mcr.microsoft.com/devcontainers/typescript-node:26",
  "postCreateCommand": "npm install -g pnpm && pnpm install --frozen-lockfile",
  "mounts": ["source=${localEnv:HOME}/.claude,target=/home/node/.claude,type=bind"],
  "customizations": {
    "vscode": {
      "extensions": [
        "Angular.ng-template",
        "anthropic.claude-code",
        "ms-playwright.playwright",
        "streetsidesoftware.code-spell-checker",
        "VoidZero.vite-plus-extension-pack"
      ]
    },
    "zed": {
      "extensions": ["angular"]
    }
  }
}
